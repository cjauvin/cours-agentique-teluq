{
  // Environnement GitHub Codespaces du cours : Python 3.12, uv, et toutes les
  // dépendances des laboratoires (dont PyTorch, en version CPU sous Linux).
  "name": "IA agentique",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "onCreateCommand": "pipx install uv && uv sync",
  "forwardPorts": [2718],
  "portsAttributes": {
    "2718": { "label": "marimo", "onAutoForward": "openBrowser" }
  },
  // Le laboratoire 3 charge un modèle d'environ 2,5 Go en mémoire.
  "hostRequirements": { "memory": "8gb" }
}
